Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: CTR and curved lumen
      Topic:
        Value: /ctr/visualization
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Reference path
      Topic:
        Value: /ctr/reference/path
      Line Style: Lines
      Line Width: 0.003
      Color: 239; 41; 41
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Tip pose
      Topic:
        Value: /ctr/tip
      Shape: Arrow
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.28
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.08
      Pitch: 0.55
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
