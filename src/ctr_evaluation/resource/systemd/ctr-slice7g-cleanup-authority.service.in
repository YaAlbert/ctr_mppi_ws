[Unit]
Description=CTR Slice 7G root-owned monotonic cleanup authority
After=local-fs.target
Before=ctr-slice7g-authority.service ctr-slice7g-observer-supervisor.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/ctr-mppi/ctr-slice7g-cleanupd
WorkingDirectory=/
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
Delegate=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallFilter=~fork vfork clone clone3
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/ctr-mppi/slice-7g-authority /opt/ctr-mppi/slice-7g /usr/libexec/ctr-mppi
ReadWritePaths=/var/lib/ctr-mppi/slice-7g-cleanup-authority /run/ctr-mppi/slice-7g-cleanup-authority
RuntimeDirectory=ctr-mppi/slice-7g-cleanup-authority
RuntimeDirectoryMode=0755
Restart=no

[Install]
WantedBy=multi-user.target
